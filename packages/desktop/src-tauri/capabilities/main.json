{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Default capabilities for the main window of the Auror app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "store:default",
    "shell:allow-open",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    }
  ]
}
