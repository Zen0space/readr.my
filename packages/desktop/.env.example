# Desktop (Tauri + Vite) — copy to .env and fill in real values.
# Only VITE_* keys are inlined into the bundle; nothing else is read.
# These ship inside the desktop binary, so treat them as public.

VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
