# @auror/admin (Next.js) — copy to .env.local and fill in real values.

# ---------- Public (shipped to the browser) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- Server-only ----------
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Apex cookie (production only) ----------
# Same Domain=.auror.my as reader/author — a single login authenticates
# across all three subdomains. The admin middleware still re-verifies
# role === 'admin' on every request; the cookie just carries the session.
NEXT_PUBLIC_COOKIE_DOMAIN=

# ---------- Backend same-origin proxy ----------
BACKEND_URL=http://localhost:4000

# ---------- Node runtime ----------
NODE_ENV=development
PORT=3000