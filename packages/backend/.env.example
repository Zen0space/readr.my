# Backend (Fastify) — copy to .env and fill in real values.
# All keys are parsed through packages/backend/src/config/env.ts (Zod).
# Never commit .env.

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------- Supabase ----------
# Local dev: `supabase start` prints these.
# Production: copy from Supabase dashboard / self-hosted instance.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — only set if your project still uses legacy HS256 JWTs.
# Leave empty for the new sb_publishable / sb_secret key system (JWKS).
SUPABASE_JWT_SECRET=

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- CORS ----------
# Comma-separated list of allowed origins. Include the Tauri origins so the
# desktop app can call the backend.
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost

# ---------- Payments ----------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_BASE_URL=http://localhost:4000
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_XSIGN_SECRET=
