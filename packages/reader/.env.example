# @auror/reader (Next.js) — copy to .env.local and fill in real values.

# ---------- Public (shipped to the browser) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------- Server-only ----------
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Apex cookie (production only) ----------
# The auth BFF sets the session cookie with this domain so a single login
# covers reader.auror.my, author.auror.my, and admin.auror.my. Defaults to
# ".auror.my" in production; leave blank for local dev (no domain = host-only).
NEXT_PUBLIC_COOKIE_DOMAIN=

# ---------- Backend same-origin proxy ----------
# Next.js rewrites /api/v1/:path* → ${BACKEND_URL}/v1/:path*.
BACKEND_URL=http://localhost:4000

# ---------- Node runtime ----------
NODE_ENV=development
PORT=3000