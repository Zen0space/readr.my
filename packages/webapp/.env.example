# Webapp (Next.js) — copy to .env.local and fill in real values.
# Anything not prefixed with NEXT_PUBLIC_ stays on the server.

# ---------- Public (shipped to the browser) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---------- Server-only ----------
# Used by server actions / route handlers; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Node runtime
NODE_ENV=development
PORT=3000
