# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.pnp.*
jspm_packages/

# ---------- Build output (root + per-package) ----------
/dist/
/build/
/out/
/lib/
/.output/
/.vercel/
/.netlify/
/.turbo/
/.next/
/.nuxt/
/.svelte-kit/
/.astro/
/.cache/
/.parcel-cache/
/.vite/
/.rollup.cache/
/.swc/

# Allow tracked source under packages/*/lib/ — each monorepo package's
# `lib/` folder is hand-written TypeScript, not a build artifact.
/!packages/

packages/*/dist/
packages/*/build/
packages/*/out/
packages/*/.next/
packages/*/.turbo/
packages/*/.output/
packages/*/coverage/
packages/*/.nyc_output/

# ---------- TypeScript build info ----------
*.tsbuildinfo
.tsbuildinfo
*.js.map
*.mjs.map
*.cjs.map
!packages/*/lib/**/*.js.map

# ---------- Desktop (Electron / Tauri) ----------
packages/desktop/src-tauri/target/
packages/desktop/src-tauri/gen/
packages/desktop/release/
packages/desktop/out/
*.app
*.dmg
*.exe
*.msi
*.AppImage
*.deb
*.rpm

# ---------- Test / coverage ----------
coverage/
.nyc_output/
*.lcov
.vitest-cache/
playwright-report/
test-results/
.playwright/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Env / secrets ----------
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.crt
secrets/

# ---------- Editor / OS ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Misc tooling ----------
.eslintcache
.stylelintcache
.prettiercache
.history/
.tmp/
tmp/
temp/

# ---------- AI agent skills (local-only) ----------
# Local copies of agent skills for tooling like Claude / OpenCode.
# Keep them on disk for the assistant but never commit them.
.agents/
