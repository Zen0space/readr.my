# --- Backend env ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase (hosted project). Get these from Supabase dashboard > Project Settings > API.
SUPABASE_URL=https://hlronfgxfqmgobjirqsj.supabase.co
SUPABASE_ANON_KEY=
# Required for admin endpoints, webhook handling, and BullMQ workers.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: HS256 JWT secret (legacy). If not set, backend verifies via JWKS endpoint.
SUPABASE_JWT_SECRET=

# Redis
REDIS_URL=redis://127.0.0.1:6379

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Payments. PAYMENT_PROVIDER=mock works without keys (smoke testing).
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_BASE_URL=http://localhost:4000
# Billplz (only when PAYMENT_PROVIDER=billplz)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_XSIGN_SECRET=
